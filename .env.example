# Copy this file to `.env` and fill in your own values.
# `.env` is bundled as a Flutter asset and read at startup (see lib/core/env).

# Supabase project (Settings -> API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Mapbox PUBLIC token (pk.****) used by the app at runtime.
MAPBOX_PUBLIC_TOKEN=pk.your_public_token

# Optional custom Mapbox style. Defaults to mapbox://styles/mapbox/standard.
MAPBOX_STYLE_URL=mapbox://styles/your-account/your-style-id
